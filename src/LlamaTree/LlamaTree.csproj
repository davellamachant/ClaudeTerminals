<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Two builds of the same app:
      net10.0-windows  the Windows app: a WinForms window hosting WebView2 (what the installer ships).
      net10.0          macOS and Linux (and, for trying it out, Windows too): a Photino window, which hosts WKWebView on
                       macOS, WebKitGTK on Linux and WebView2 on Windows.
    Everything but the window (sessions, terminals, git, panels, the page) is shared.
    Run it from source with `dotnet run -f net10.0-windows` (Windows) or `dotnet run` (macOS, Linux).
  -->
  <PropertyGroup>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0-windows;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Version shown in Explorer, Apps & Features and the installer. Bump for each release. -->
    <Version>1.3.1</Version>
    <Product>LlamaTree</Product>
    <AssemblyTitle>LlamaTree</AssemblyTitle>
    <Company>LLAMACHANT TECHNOLOGY LTD</Company>
    <Copyright>© LLAMACHANT TECHNOLOGY LTD</Copyright>
    <Description>Manage multiple Claude Code sessions with VS-style Git views.</Description>
    <WebDir>$(MSBuildProjectDirectory)\..\..\web</WebDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <DefineConstants>$(DefineConstants);WINFORMS</DefineConstants>
    <!-- The WebView2 package drags in its WPF assembly; harmless for WinForms. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- Windows-only calls are each behind an OperatingSystem.IsWindows() check (or only reached from one). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Compile Remove="Hosting\Photino\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <!-- Part of the Windows Desktop framework; here it comes as a package (notices are signed, see NoticeService). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <Compile Remove="Hosting\WinForms\**" />
    <Content Include="app.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LlamaTree.Tests" />
  </ItemGroup>

  <!-- Third-party front-end libraries come from web/node_modules (run `npm install` in /web). -->
  <ItemGroup>
    <XtermFiles Include="$(WebDir)\node_modules\@xterm\xterm\lib\xterm.js;$(WebDir)\node_modules\@xterm\xterm\css\xterm.css" />
    <XtermFiles Include="$(WebDir)\node_modules\@xterm\addon-*\lib\addon-*.js" />
    <MonacoFiles Include="$(WebDir)\node_modules\monaco-editor\min\vs\**\*" />
  </ItemGroup>

  <Target Name="CopyWebLibs" AfterTargets="Build">
    <Error Condition="!Exists('$(WebDir)\node_modules\monaco-editor')" Text="Front-end libraries missing. Run 'npm install' in $(WebDir)." />
    <Copy SourceFiles="@(XtermFiles)" DestinationFolder="$(OutDir)wwwroot\lib\xterm" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MonacoFiles)" DestinationFiles="@(MonacoFiles->'$(OutDir)wwwroot\lib\monaco\vs\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishWebLibs" AfterTargets="Publish">
    <Copy SourceFiles="@(XtermFiles)" DestinationFolder="$(PublishDir)wwwroot\lib\xterm" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MonacoFiles)" DestinationFiles="@(MonacoFiles->'$(PublishDir)wwwroot\lib\monaco\vs\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
